{
  "manifest_version": 3,
  "name": "ADHD Reader",
  "version": "1.0",
  "description": "A Chrome extension to help ADHD readers focus on content",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "popup/tabs/themes.html",
        "popup/tabs/settings.html",
        "popup/tabs/customies.html"
      ],
      "matches": ["<all_urls>"]
    }
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": "assets/icon.png"
  },
  "options_page": "options/option.html",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "lib/readability.js",
        "content/modules/utils.js",
        "content/modules/ProofreadingMode.js",
        "content/modules/ImmersiveMode.js",
        "content/modules/ReaderMode.js",
        "content/content.js"
      ],
      "css": [
        "content/content.css",
        "content/reader.css"
      ],
      "all_frames": false, 
      "run_at": "document_start"
    }
  ],
  "icons": {
    // "16": "iassets/icon.png",
    // "32": "assets/icon.png",
    "48": "assets/icon.png"
    // "128": "iassets/icon.png"
  },
  "content_security_policy": {
    "script-src": "'self' 'unsafe-eval'",
    "object-src": "'self'"
  }
}

